rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isMember(teamId) {
      return signedIn() &&
        exists(/databases/$(database)/documents/teams/$(teamId)/members/$(request.auth.uid));
    }

    function isOwner(teamId) {
      return isMember(teamId) &&
        get(/databases/$(database)/documents/teams/$(teamId)/members/$(request.auth.uid)).data.role == 'owner';
    }

    match /users/{userId} {
      allow read: if signedIn() && request.auth.uid == userId;
      allow create: if signedIn() && request.auth.uid == userId;
      allow update: if signedIn() && request.auth.uid == userId;
      allow delete: if false;
    }

    match /teams/{teamId} {
      allow read: if isMember(teamId);
      allow create: if signedIn() && request.resource.data.ownerId == request.auth.uid;
      allow update, delete: if isOwner(teamId);

      match /members/{memberId} {
        allow read: if isMember(teamId);
        allow create: if isOwner(teamId) && request.resource.data.userId == memberId;
        allow update, delete: if isOwner(teamId) || request.auth.uid == memberId;
      }
    }

    match /projects/{projectId} {
      allow read, update: if signedIn() && request.auth.uid in resource.data.memberIds;
      allow create: if signedIn() && request.auth.uid in request.resource.data.memberIds;
      allow delete: if signedIn() && request.auth.uid == resource.data.ownerId;
    }

    match /tasks/{taskId} {
      allow read, update: if signedIn() &&
        (request.auth.uid in resource.data.memberIds ||
         request.auth.uid == resource.data.assigneeId);
      allow create: if signedIn() && request.auth.uid in request.resource.data.memberIds;
      allow delete: if signedIn() && request.auth.uid == resource.data.createdBy;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
