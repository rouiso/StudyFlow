# Base de données (SQLite en local par défaut pour exécution immédiate sans Docker, ou PostgreSQL via docker compose)
DATABASE_URL="file:./dev.db"
# Pour basculer sur PostgreSQL Docker :
# DATABASE_URL="postgresql://studyflow:studyflow@localhost:5432/studyflow"

# Authentification
AUTH_SECRET="studyflow_secret_key_validation_2026"
AUTH_URL="http://localhost:3000"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Serveur Auxiliaire Temps Réel & Cron
REALTIME_PORT=4000
NEXT_PUBLIC_REALTIME_URL="http://localhost:4000"

# Stockage de fichiers (M6)
UPLOAD_DIR="./uploads"
MAX_UPLOAD_MB=20
TEAM_QUOTA_MB=500

# E-mails de test (Mailpit)
EMAIL_SERVER="smtp://localhost:1025"
EMAIL_FROM="studyflow@localhost"
